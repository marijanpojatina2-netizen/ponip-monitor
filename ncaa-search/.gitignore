# The repo-root .gitignore ignores data/ globally; re-include this project's
# cache dir placeholder but keep generated artifacts (DB, cache) out of git.
!data/cache/
data/ncaa.db
data/ncaa.db-wal
data/ncaa.db-shm
data/cache/*
!data/cache/.gitkeep

# Generated export (built by the GitHub Action with real data)
web/data.json

__pycache__/
*.pyc
.venv/
venv/
