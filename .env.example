# =============================================================================
# PONIP Monitor — .env za LOKALNO testiranje
# =============================================================================
# Na GitHub Actions, ove vrijednosti dolaze iz repo Secrets (ne iz .env).
# Ovo je samo za lokalne run-ove.
#
# chmod 600 .env   (osigurana datoteka)
# =============================================================================

# --- Claude Max OAuth ---
# Generiraj lokalno: claude setup-token (valjan 1 godinu)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# VAŽNO: NE postavljaj ANTHROPIC_API_KEY ovdje!
# Claude Code koristi OAuth kad je token postavljen → Max subscription.
# ANTHROPIC_API_KEY bi trošio pay-per-token API budget.

# --- SMTP (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tvoj.email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=tvoj.email@gmail.com
SMTP_USE_TLS=0

# --- Primatelj digest maila ---
PONIP_EMAIL_TO=marijan@example.hr

# --- URL dashboarda (za link u mailu) ---
# Nakon što pushaš repo i aktiviraš Pages:
# https://TVOJ-USERNAME.github.io/IME-REPOA/
PONIP_PUBLIC_URL=https://tvoj-username.github.io/ponip-monitor/

# --- Opcionalno ---
# Ako želiš testirati bez slanja emaila:
# PONIP_DRY_RUN=1
